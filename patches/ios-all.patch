+fn installed_stds() -> Vec<Vec<u8>> {
+    let Some(exe) = std::env::current_exe().ok() else {
+        return Vec::new();
+    };
+    let dir = exe.with_file_name("horizon-wasm-std");
+    let mut paths: Vec<_> = std::fs::read_dir(&dir)
+        .ok()
+        .into_iter()
+        .flatten()
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .filter(|path| path.extension().is_some_and(|ext| ext == std::ffi::OsStr::new("wasm")))
+        .collect();
+    paths.sort();
+    let mut stds: Vec<Vec<u8>> = paths
+        .into_iter()
+        .filter_map(|path| std::fs::read(path).ok())
+        .collect();
+    // Older packages carry one std beside the executable.
+    if stds.is_empty()
+        && let Ok(bytes) = std::fs::read(exe.with_file_name("horizon-wasm-std.wasm"))
+    {
+        stds.push(bytes);
+    }
+    stds

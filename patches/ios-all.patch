+#[cfg(target_os = "ios")]
+static IOS_MOTION: std::sync::Mutex<[f64; 2]> = std::sync::Mutex::new([0.0; 2]);
+
+#[cfg(target_os = "ios")]
+static IOS_HARDWARE_INPUT: AtomicBool = AtomicBool::new(false);
+
+#[cfg(target_os = "ios")]
+static IOS_HARDWARE_MOUSE: AtomicBool = AtomicBool::new(false);
+
+#[cfg(target_os = "ios")]
+pub fn add_ios_motion(x: f64, y: f64) {
+    if !x.is_finite() || !y.is_finite() {
+        return;
+    }
+    if let Ok(mut motion) = IOS_MOTION.lock() {
+        motion[0] = (motion[0] + x).clamp(-180.0, 180.0);
+        motion[1] = (motion[1] + y).clamp(-180.0, 180.0);
+    }
+}
+
+#[cfg(target_os = "ios")]
+pub(crate) fn take_ios_motion() -> [f64; 2] {
+    IOS_MOTION.lock().map_or([0.0; 2], |mut motion| std::mem::take(&mut *motion))
+}
+
+#[cfg(target_os = "ios")]
+pub fn set_ios_hardware_input(attached: bool, mouse: bool) {
+    IOS_HARDWARE_INPUT.store(attached, Ordering::SeqCst);
+    IOS_HARDWARE_MOUSE.store(attached && mouse, Ordering::SeqCst);
+}
+
+#[cfg(target_os = "ios")]
+pub(crate) fn ios_hardware_input() -> bool {
+    IOS_HARDWARE_INPUT.load(Ordering::SeqCst)
+}
+
+#[cfg(target_os = "ios")]
+pub(crate) fn ios_hardware_mouse() -> bool {
+    IOS_HARDWARE_MOUSE.load(Ordering::SeqCst)
+}
+
+#[cfg(target_os = "ios")]
+static IOS_POINTER_HIDDEN: AtomicBool = AtomicBool::new(false);
+
+/// Whether the game currently holds the pointer (playing) and the shell
+/// should hide the system cursor. Menus release it so their cursor returns.
+#[cfg(target_os = "ios")]
+pub fn set_ios_pointer_hidden(hidden: bool) {
+    IOS_POINTER_HIDDEN.store(hidden, Ordering::SeqCst);
+}
+
+#[cfg(target_os = "ios")]
+pub fn ios_pointer_hidden() -> bool {
+    IOS_POINTER_HIDDEN.load(Ordering::SeqCst)
+}
+
+/// iOS startup: the app has no command line, so the shell supplies the resource
+/// directory and the writable game directory. The synthetic command line is
+/// accepted by the same parser the desktop executable uses.
+pub fn prepare_ios(resources: PathBuf, game_dir: PathBuf) -> Result<Startup, String> {
+    let exe = std::env::current_exe().map_err(|error| error.to_string())?;
+    let mut command = std::process::Command::new(exe);
+    command
+        .arg("--resources")
+        .arg(resources)
+        .arg("--game-dir")
+        .arg(game_dir)
+        .arg("--no-pause");
+    let launch =
+        LaunchArguments::for_command(&command).map_err(|error| error.to_string())?;
+    let options = game::Options::validate(launch.clone())
+        .map_err(|error| error.to_string())?
+        .ok_or_else(|| "iOS startup cannot use --help".to_owned())?;
+    Ok(Startup {
+        launch,
+        options,
+        _capture: None,
+    })
+}
+
 /// Refuse startup if any merged copy could not be installed, before loading any mod.
 /// Cells cannot roll back: each copy merges all requesting rows, so stopping the whole

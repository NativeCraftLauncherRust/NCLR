+    /// The control the NCLR launcher's `keymap.json` id moves, if it maps to
+    /// one of the built-in touch controls. The four movement ids share the
+    /// joystick: the launcher draws them as one pad, the game has one stick.
+    fn from_launcher_id(id: &str) -> Option<Self> {
+        match id {
+            "forward" | "back" | "left" | "right" => Some(Self::Move),
+            "sprint" => Some(Self::Sprint),
+            "jump" => Some(Self::Jump),
+            "sneak" => Some(Self::Sneak),
+            "attack" => Some(Self::Attack),
+            "use" => Some(Self::Use),
+            "inventory" => Some(Self::Inventory),
+            "chat" => Some(Self::Chat),
+            "pause" => Some(Self::Pause),
+            "settings" => Some(Self::Settings),
+            "debug" => Some(Self::Debug),
+            "perspective" => Some(Self::Perspective),
+            "offhand" => Some(Self::Offhand),
+            "shield" => Some(Self::Shield),
+            _ => None,
+        }
+    }
 }
 

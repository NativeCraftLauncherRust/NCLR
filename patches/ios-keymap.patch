+    /// Applies the NCLR launcher's `keymap.json` (`buttonSize` and `layout`)
+    /// to the built-in controls. New ids the launcher adds stay in the file;
+    /// this game version has no extra touch controls to bind them to.
+    pub fn apply_launcher_keymap(&mut self, path: &Path) {
+        let Ok(bytes) = std::fs::read(path) else {
+            return;
+        };
+        let Ok(json) = serde_json::from_slice::<serde_json::Value>(&bytes) else {
+            return;
+        };
+        if let Some(scale) = json.get("buttonSize").and_then(|v| v.as_f64()) {
+            self.button_scale = (scale as f32).clamp(0.5, 2.0);
+        }
+        let Some(layout) = json.get("layout").and_then(|v| v.as_object()) else {
+            return;
+        };
+        for (id, value) in layout {
+            let Some(control) = Control::from_launcher_id(id) else {
+                continue;
+            };
+            let Some(value) = value.as_object() else {
+                continue;
+            };
+            let x = value.get("x").and_then(|v| v.as_f64()).unwrap_or(0.5) as f32;
+            let y = value.get("y").and_then(|v| v.as_f64()).unwrap_or(0.5) as f32;
+            let size = value.get("size").and_then(|v| v.as_f64()).unwrap_or(0.12) as f32;
+            let placement = Placement {
+                center: [x, y],
+                size,
+                opacity: 0.65,
+            };
+            for row in &mut self.layouts {
+                row[control as usize] = placement;
+            }
+            self.button_visibility[control as usize] = SHOWN;
+        }
+        self.sanitize();
+    }
+

+//! The `touch_input` hook: declarations the mod API generator reads (see `hooks/mod.rs`).
+
+pub trait Hooks {
+    /// A finger on a touch screen, while a world is open (`id` names it for the whole gesture).
+    /// `phase` is 0 when it lands, 1 while it moves, 2 when it lifts and 3 when the system
+    /// cancels it. `point` is where it is on the surface, `0..1` across its width and height —
+    /// the surface the HUD draws on, so `point` times a `DrawContext`'s size is that point in
+    /// GUI pixels — and `surface` is that surface in pixels.
+    ///
+    /// Set `canceled` to take the finger: the game's own touch controls ignore it for the rest
+    /// of its gesture, so a mod's controls and the built-in joystick never answer the same
+    /// finger. A mod that draws its own controls cancels the fingers that land on them and
+    /// leaves the rest to the game.
+    ///
+    /// Fired for every finger, before the built-in touch controls see it, whether or not a
+    /// hardware keyboard or mouse is attached, and whether or not the player has a touch
+    /// layout: a mod's overlay is told of touches the game's controls would drop. Not on the
+    /// title screen or the loading screen, where a finger is the menus' own click.
+    /// Client only, and only on a touch screen: a platform without one never fires it.
+    #[hook(
+        side = "client",
+        contract = "cancel",
+        out = "canceled",
+        neoforge = "none (NeoForge has no touch event; a touchscreen reaches it as a mouse)"
+    )]
+    fn touch_input();
+}

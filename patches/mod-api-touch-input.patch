+++ b/crates/horizon-client/src/game/native_hooks/touch_input.rs
@@ -0,0 +1,19 @@
+use super::*;
+
+/// The hook points. Each does nothing in Horizon.
+impl Game<'_> {
+    /// A finger on the touch screen, before the built-in touch controls see it: `id` names it
+    /// for the gesture, `phase` is 0 (land), 1 (move), 2 (lift) or 3 (cancel), `point` is
+    /// `0..1` across the surface and `surface` its size in pixels. Set `canceled` to take the
+    /// finger from the game's own controls.
+    pub(in crate::game) fn native_touch_input(
+        &mut self,
+        id: u64,
+        phase: i32,
+        point: [f32; 2],
+        surface: [u32; 2],
+        canceled: &mut bool,
+    ) {
+        self.fire_touch_input(id, phase, point, surface, canceled);
+    }
+}
